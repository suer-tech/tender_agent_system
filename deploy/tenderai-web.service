[Unit]
Description=TenderAI web UI (FastAPI + uvicorn)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=user1
WorkingDirectory=/home/user1/tender_agent_system
EnvironmentFile=/home/user1/tender_agent_system/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/user1/tender_agent_system/.venv/bin/python -m uvicorn apps.web.app:app \
    --host 127.0.0.1 --port 8765 \
    --workers 2 --proxy-headers --forwarded-allow-ips='*'
Restart=on-failure
RestartSec=5
StandardOutput=append:/var/log/tenderai-web.log
StandardError=append:/var/log/tenderai-web.log

[Install]
WantedBy=multi-user.target
